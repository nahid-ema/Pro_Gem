{
  "entities": {
    "RentRecord": {
      "title": "Rent Record",
      "description": "Represents a monthly rent collection record for a tenant/room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantName": { "type": "string" },
        "roomNo": { "type": "string" },
        "month": { "type": "string" },
        "year": { "type": "string" },
        "amount": { "type": "number" },
        "paid": { "type": "number" },
        "due": { "type": "number" },
        "date": { "type": "string" },
        "note": { "type": "string" },
        "paymentMethod": { "type": "string" }
      },
      "required": ["id", "tenantName", "roomNo", "amount"]
    },
    "Expense": {
      "title": "Expense Record",
      "description": "Represents property operating expenses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "desc": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "desc", "amount"]
    },
    "ShopDue": {
      "title": "Shop Due Record",
      "description": "Represents store / dokan dues and credits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "desc": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" }
      },
      "required": ["id", "desc", "amount"]
    },
    "Tenant": {
      "title": "Tenant Record",
      "description": "Represents a tenant assigned to a room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "roomNo": { "type": "string" },
        "phone": { "type": "string" },
        "rentAmount": { "type": "number" },
        "advanceAmount": { "type": "number" },
        "joinDate": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "roomNo"]
    }
  },
  "firestore": {
    "/rents/{rentId}": {
      "schema": "#/entities/RentRecord",
      "description": "Rent collection documents"
    },
    "/expenses/{expenseId}": {
      "schema": "#/entities/Expense",
      "description": "Expense records"
    },
    "/dokanDues/{dueId}": {
      "schema": "#/entities/ShopDue",
      "description": "Shop credit / due records"
    },
    "/tenants/{tenantId}": {
      "schema": "#/entities/Tenant",
      "description": "Tenant registry records"
    }
  }
}
